<%- include('partials/header', { title: 'Dashboard' }) %>
<section class="page-head">
  <div>
    <h1>Dashboard</h1>
    <p class="lead"><%= dateLabel %></p>
  </div>
  <% if (user.role === 'admin') { %>
    <div class="page-actions">
      <a class="btn" href="/scan"><svg class="icon"><use href="#i-scan"/></svg>Pindai QR</a>
      <a class="btn btn-ghost" href="/attendance">Input manual</a>
    </div>
  <% } %>
</section>

<div class="today-grid">
  <section class="panel today" aria-labelledby="today-heading">
    <h2 id="today-heading">Absensi hari ini</h2>
    <p class="today-sum">
      <strong><%= recorded %></strong> dari <%= total %> anggota aktif sudah tercatat<% if (pending > 0) { %>, <%= pending %> belum<% } %>.
    </p>
    <% if (total > 0) { %>
      <div class="tally" role="img" aria-label="<%= STATUSES.map(s => STATUS_LABELS[s] + ' ' + counts[s]).join(', ') %>, belum dicatat <%= pending %>">
        <% STATUSES.forEach(s => { if (counts[s] > 0) { %>
          <span style="flex: <%= counts[s] %>; background: <%= STATUS_COLORS[s] %>"></span>
        <% } }) %>
        <% if (pending > 0) { %><span class="tally-pending" style="flex: <%= pending %>"></span><% } %>
      </div>
    <% } %>
    <dl class="tally-legend">
      <% STATUSES.forEach(s => { %>
        <div>
          <dt><span class="dot" style="background: <%= STATUS_COLORS[s] %>"></span><%= STATUS_LABELS[s] %></dt>
          <dd><%= counts[s] %></dd>
        </div>
      <% }) %>
      <div>
        <dt><span class="dot dot-pending"></span>Belum dicatat</dt>
        <dd><%= pending %></dd>
      </div>
    </dl>
  </section>

  <section class="panel feed" aria-labelledby="feed-heading">
    <div class="panel-head">
      <h2 id="feed-heading">Masuk terbaru</h2>
      <span class="small muted">Lewat pindai QR</span>
    </div>
    <% if (recent.length) { %>
      <ol class="feed-list">
        <% recent.forEach(r => { %>
          <li>
            <span class="avatar avatar-sm" aria-hidden="true"><%= formatTitleCase(r.name).charAt(0) %></span>
            <span class="feed-name"><strong><%= formatTitleCase(r.name) %></strong><small><%= r.type === 'tutor' ? 'Tutor' : 'Staf' %></small></span>
            <time class="feed-time"><%= hhmm(r.check_in_time) %></time>
          </li>
        <% }) %>
      </ol>
    <% } else { %>
      <p class="empty">
        Belum ada yang memindai kartu hari ini.
        <% if (user.role === 'admin') { %><a class="text-link" href="/scan">Buka pemindai</a><% } %>
      </p>
    <% } %>
  </section>
</div>

<section class="panel chart-panel" aria-labelledby="attendance-chart-heading">
  <div class="chart-panel-heading">
    <div>
      <h2 id="attendance-chart-heading">Grafik kehadiran</h2>
      <p class="muted">
        <% if (chart.mode === 'harian') { %>Jumlah catatan per hari, <%= chartPeriodLabel %><% } else { %>Jumlah catatan per bulan, <%= chartPeriodLabel %><% } %>
      </p>
    </div>
    <div class="segmented-control" role="group" aria-label="Pilih periode grafik">
      <a class="<%= chart.mode === 'harian' ? 'selected' : '' %>" href="<%= chartModeUrls.harian %>" <%- chart.mode === 'harian' ? 'aria-current="page"' : '' %>>Harian</a>
      <a class="<%= chart.mode === 'bulanan' ? 'selected' : '' %>" href="<%= chartModeUrls.bulanan %>" <%- chart.mode === 'bulanan' ? 'aria-current="page"' : '' %>>Bulanan</a>
    </div>
  </div>

  <form method="get" action="/" class="chart-filters">
    <input type="hidden" name="mode" value="<%= chart.mode %>">
    <% if (chart.mode === 'harian') { %>
      <input type="hidden" name="year" value="<%= chart.year %>">
      <label class="field period-control"><span>Bulan</span>
        <input type="month" name="month" value="<%= chart.month %>">
      </label>
    <% } else { %>
      <input type="hidden" name="month" value="<%= chart.month %>">
      <label class="field period-control"><span>Tahun</span>
        <input type="number" name="year" min="1900" max="9999" step="1" value="<%= chart.year %>">
      </label>
    <% } %>
    <fieldset class="status-filter">
      <legend>Tampilkan status</legend>
      <div class="status-options">
        <% chartStatusOptions.forEach(option => { %>
          <label class="status-chip">
            <input type="checkbox" name="status" value="<%= option.value %>" <%= option.checked ? 'checked' : '' %>>
            <span class="dot" style="background: <%= option.color %>"></span>
            <span><%= option.label %></span>
          </label>
        <% }) %>
      </div>
    </fieldset>
    <button class="btn btn-ghost btn-sm filter-button" type="submit">Terapkan</button>
  </form>

  <% if (!chart.hasData) { %>
    <div class="chart-stage chart-empty-stage" role="status">
      <div class="chart-empty-state">
        <strong><%= chart.hasAnyData ? 'Tidak ada catatan untuk status yang dipilih' : 'Belum ada catatan absensi pada periode ini' %></strong>
        <span><%= chart.hasAnyData ? 'Pilih status lain untuk melihat grafik.' : 'Grafik terisi setelah absensi dicatat.' %></span>
      </div>
    </div>
  <% } else { %>
    <div class="chart-stage">
      <div class="chart-scroll">
        <svg class="attendance-chart" viewBox="0 0 <%= chart.width %> <%= chart.height %>"
             role="group" aria-labelledby="chart-svg-title chart-svg-description">
          <title id="chart-svg-title">Grafik absensi <%= chart.mode === 'harian' ? 'harian' : 'bulanan' %></title>
          <desc id="chart-svg-description">Gunakan mouse atau keyboard untuk melihat rincian status setiap tanggal atau bulan.</desc>
          <% chart.ticks.forEach(tick => { %>
            <line class="chart-grid-line" x1="<%= chart.left %>" y1="<%= tick.y %>"
                  x2="<%= chart.width - chart.right %>" y2="<%= tick.y %>"></line>
            <text class="chart-axis-label" x="<%= chart.left - 12 %>" y="<%= tick.y + 4 %>" text-anchor="end"><%= tick.value %></text>
          <% }) %>
          <% chart.columns.forEach(column => { %>
            <g class="chart-column" tabindex="0" role="group"
               aria-label="<%= column.ariaLabel %>" aria-describedby="chart-tooltip"
               data-tooltip-title="<%= column.tooltipTitle %>"
               data-tooltip-total="<%= column.total %>"
               data-tooltip-statuses="<%= JSON.stringify(column.tooltipStatuses) %>">
              <title><%= column.ariaLabel %></title>
              <rect class="chart-hover-area" x="<%= column.x %>" y="<%= chart.top %>"
                    width="<%= column.width %>" height="<%= chart.plotHeight %>"></rect>
              <line class="chart-column-guide" x1="<%= column.center %>" y1="<%= chart.top %>"
                    x2="<%= column.center %>" y2="<%= chart.baseline %>"></line>
              <% column.segments.forEach(segment => { %>
                <path class="chart-bar-segment" d="<%= segment.path %>" fill="<%= segment.color %>"></path>
              <% }) %>
              <text class="chart-axis-label chart-x-label" x="<%= column.center %>"
                    y="<%= chart.baseline + 27 %>" text-anchor="middle"><%= column.label %></text>
            </g>
          <% }) %>
        </svg>
      </div>
      <div class="chart-tooltip" id="chart-tooltip" role="tooltip" hidden>
        <strong class="chart-tooltip-title"></strong>
        <ul class="chart-tooltip-statuses"></ul>
        <div class="chart-tooltip-total"><span>Total seluruh status</span><strong></strong></div>
      </div>
    </div>
    <script src="/dashboard-chart.js" defer></script>
  <% } %>
</section>
<%- include('partials/footer') %>
